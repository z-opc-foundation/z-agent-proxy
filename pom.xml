<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        z-agent-proxy: 三方 agent 适配代理.
        - adapter 模块: 把第三方 agent (Cursor / Operator / Aider / Codeium / Continue) 的接口协议
          转译成 z-agent-kernel 的内部 SPI (Agent SPI), 让平台/z-team 把它们当作内部 agent 调度.

        对标 Composio / Agent Protocol Adapter / MCP Client 集.

        适配目标:
        - Cursor (IDE 内嵌 agent, 通过 LSP/RPC)
        - OpenAI Operator (浏览器 agent, REST)
        - Aider (CLI git-aware, Python 子进程)
        - Codeium (IDE 内嵌, REST)
        - Continue (VSCode 插件, REST)

        用户原话: "将他者 agent 纳入我们的体系, 可以随意支配任何三方 agent"
    -->

    <!-- 统一走 z-boot-parent（第三方地板 + fleet 兄弟仓权威 + Java 8 构建口径）；relativePath 必须留空：parent 在 repo1，不在磁盘。 -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-parent</artifactId>
        <version>1.0.19</version>
        <relativePath/>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-agent-proxy</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>

    <name>z-agent-proxy (Third-party Agent Adapter)</name>
    <description>三方 agent 适配代理: Cursor / Operator / Aider / Codeium / Continue → z-agent-kernel Agent SPI</description>
    <url>https://github.com/z-opc-foundation/z-agent-proxy</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-agent-proxy.git</connection>
        <developerConnection>scm:ssh:git@github.com/z-opc-foundation/z-agent-proxy.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-agent-proxy</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <revision>0.1.1</revision>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 自家坐标钉 ${project.version}（挡住继承来的 fleet 旧格 0.1.0 反污染本仓产物）。
                 kotlin 四格写字面 1.9.21：父链（spring-boot 2.7.18）把 okhttp 4.12.0 自带的 1.8.21、地板 okio 3.9.0 自带的 1.9.21 一起压成 1.6.21 ⇒ 拒静默降级。 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-agent-proxy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib</artifactId>
                <version>1.9.21</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib-common</artifactId>
                <version>1.9.21</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib-jdk7</artifactId>
                <version>1.9.21</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib-jdk8</artifactId>
                <version>1.9.21</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 三方代理只需 kernel.agent SPI + kernel.message + kernel.types (其他按需) -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-agent-kernel-agent</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-agent-kernel-message</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-agent-kernel-types</artifactId>
        </dependency>

        <!-- OkHttp 用于远程三方 agent 通信 (Cursor/Operator/Codeium/Continue 都走 REST) -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- slf4j-api 留字面 2.0.16：父链给的是 spring-boot 2.7.18 的 1.7.36，删这行就是静默降级。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.16</version>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>3.1.1</version>
                <configuration>
                    <tagNameFormat>v@{project.version}</tagNameFormat>
                </configuration>
            </plugin>
            <!-- 中央 0.1.0 那份 pom 是 <parent> 计数 0 的自包含 raw pom，只是自身 <version> 没展开 ⇒ 常开 flatten oss：
                 保住自包含形状、把版本号与依赖面值都落成正文字面量；挂 profile 会让不带 -P 的 install 入库带 parent 的 pom。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.5.0</version>
                <inherited>true</inherited>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                                <configuration>
                                    <doclint>none</doclint>
                                    <failOnError>false</failOnError>
                                    <failOnWarnings>false</failOnWarnings>
                                    <quiet>true</quiet>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>